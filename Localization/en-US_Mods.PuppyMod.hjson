		DisplayName: Golden Clicker
		Tooltip: puppy deserves expensive clicks
	}

	CollarItem: {
		DisplayName: Puppy Collar
		Tooltip: Wear this so an Owner can gently leash you — snug & shiny :3 (+2 defense!)
	}

	ChainLeashItem: {
		DisplayName: Chain Leash
		Tooltip: Sturdy chain, 10 tiles — may poison foes, puppy gets +5 defense! Right-click a collared puppy to clip! *walkies!*
	}

	RopeLeashItem: {
		DisplayName: Rope Leash
		Tooltip: Soft rope, 12 tiles — stretchy and zoomy! Puppy gets +15% move speed! Right-click to clip/unclip! *wag!*
	}

	RubberLeashItem: {
		DisplayName: Rubber Leash
		Tooltip: Bouncy rubber, super stretchy walkies! *boing!* :3
	}

	ElasticLeashItem: {
		DisplayName: Elastic Leash
		Tooltip: Extra elastic walkies — stretchy & zoomy! *stretch!* :3
	}

	ExponentialLeashItem: {
		DisplayName: Springy Leash
		Tooltip: Springy and bouncy walkies! *spring!* zoom zoom! :3
	}

	PuppyEarsItem: {
		DisplayName: Puppy Ears
		Tooltip: Floppy ears! *paw paw* diggy zoom! :3
	}

	PuppyTailItem: {
		DisplayName: Puppy Tail
		Tooltip: Waggy tail! *wag wag* zoomies incoming! :3
	}
}

